# Default: let Git treat normal text files safely
* text=auto
# Windows launchers
*.cmd text eol=crlf
*.bat text eol=crlf
# PowerShell scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
# Git patches should stay LF
*.patch text eol=lf
*.diff text eol=lf
# Source/config text files
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=lf
*.xml text eol=lf
*.param text eol=lf
*.md text eol=lf
*.txt text eol=lf
